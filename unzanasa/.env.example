# UNZANASA Academic Hub — environment
# Copy to .env.local (dev) or set these in your host's environment (prod).
# Run `npm run preflight` to validate before deploying.

# ── App ────────────────────────────────────────────────────────────────
# Public base URL — used to build links in verification / reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Auth (required in production) ───────────────────────────────────────
# Sign key for session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=
# Set to 1 to allow the insecure dev secret in a throwaway prod build. Never
# use this for a real deployment.
# COGNIFY_ALLOW_DEV_SECRET=

# ── Database (recommended for production) ──────────────────────────────
# When set, accounts + cloud sync use PostgreSQL via Prisma. When unset, the
# app falls back to a JSON file store under .data/ (fine for a demo, not
# durable for production).
DATABASE_URL=postgresql://unzanasa:unzanasa@localhost:5432/unzanasa?schema=public
# Where the file store lives when DATABASE_URL is unset (default: ./.data).
# COGNIFY_DATA_DIR=

# ── Transactional email ────────────────────────────────────────────────
# Password-reset + verification mail. With RESEND_API_KEY unset, mail is
# written to .data/outbox/ as JSON (dev links surfaced in responses) — every
# flow works locally with zero configuration. Get a key at https://resend.com
RESEND_API_KEY=
MAIL_FROM=UNZANASA Hub <no-reply@unzanasa.org>

# ── AI tutor (optional) ────────────────────────────────────────────────
# Provide any one key to use a live model; with none set, the tutor runs on
# the built-in offline engine. The router picks whatever is configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Preferred provider when several keys are set:
# anthropic | openai | google | mistral | deepseek
AI_DEFAULT_PROVIDER=anthropic
