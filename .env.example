# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://cognify:cognify@localhost:5432/cognify?schema=public

# ── Redis (sessions, queues, rate limiting) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-`openssl rand -base64 32`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── AI providers (any subset; the router picks what is configured) ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Preferred provider: anthropic | openai | google | mistral | deepseek
AI_DEFAULT_PROVIDER=anthropic

# ── Storage (S3-compatible: AWS S3 / Cloudflare R2) ────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cognify-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Search (Meilisearch) ───────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# ── Payments (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Cognify <no-reply@cognify.app>

# ── Monitoring & analytics ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
